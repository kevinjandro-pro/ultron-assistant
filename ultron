#!/bin/bash
# ultron - CLI de "Ultrón. Control de voz" (Exclusivo para Antigravity)

CONFIG_DIR="$HOME/.config/ultron-assistant"
PID_FILE="$CONFIG_DIR/ultron.pid"
LOG_FILE="$CONFIG_DIR/assistant.log"
SCRIPT_PATH="$CONFIG_DIR/assistant.py"
CONFIG_PATH="$CONFIG_DIR/config.json"

# Usar el Python del entorno virtual aislado si existe
if [ -f "$CONFIG_DIR/.venv/bin/python3" ]; then
    PYTHON_BIN="$CONFIG_DIR/.venv/bin/python3"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN=$(command -v python3)
else
    PYTHON_BIN="/usr/bin/python3"
fi

get_pid() {
    pgrep -f "assistant.py" | head -n 1
}

is_running() {
    local pid=$(get_pid)
    if [ -n "$pid" ]; then
        return 0
    else
        return 1
    fi
}

start_ultron() {
    if is_running; then
        local pid=$(get_pid)
        echo "⚡ Ultrón ya está ACTIVO y escuchando en segundo plano (PID $pid)."
        return 0
    fi

    if [ ! -f "$SCRIPT_PATH" ]; then
        echo "❌ No se encontró $SCRIPT_PATH. Ejecuta primero el instalador: ./install.sh"
        exit 1
    fi

    # Limpiar procesos huérfanos previos
    pkill -9 -f "ffmpeg.*avfoundation" 2>/dev/null

    nohup "$PYTHON_BIN" -u "$SCRIPT_PATH" > "$LOG_FILE" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$PID_FILE"
    
    sleep 1.5
    if is_running; then
        echo "✅ Ultrón INICIADO correctamente en segundo plano (PID $(get_pid))."
        echo "   Di 'Hey Ultrón' o presiona 'Option + Shift + E' para hablar."
    else
        echo "❌ Error al iniciar Ultrón. Revisa los logs con: ultron logs"
    fi
}

stop_ultron() {
    if ! is_running; then
        echo "⚪ Ultrón ya está DESACTIVADO (no hay ningún proceso corriendo)."
        pkill -9 -f "ffmpeg.*avfoundation" 2>/dev/null
        rm -f "$PID_FILE" 2>/dev/null
        return 0
    fi

    pkill -f "assistant.py" 2>/dev/null
    sleep 0.5
    pkill -9 -f "ffmpeg.*avfoundation" 2>/dev/null
    rm -f "$PID_FILE" 2>/dev/null

    echo "🛑 Ultrón ha sido DESACTIVADO por completo."
    echo "   El micrófono ha sido liberado."
}

show_status() {
    local sens="6/10"
    local amp="0.050"
    if [ -f "$CONFIG_PATH" ]; then
        local info=$("$PYTHON_BIN" -c "
import json
try:
    cfg = json.load(open('$CONFIG_PATH'))
    lvl = cfg.get('sensitivity_level', 6)
    amp = cfg.get('min_amplitude', 0.050)
    print(f'{lvl}|{amp:.3f}')
except Exception:
    print('6|0.050')
" 2>/dev/null)
        sens="$(echo "$info" | cut -d'|' -f1)/10"
        amp="$(echo "$info" | cut -d'|' -f2)"
    fi

    if is_running; then
        local pid=$(get_pid)
        local cpu=$(ps -p "$pid" -o %cpu | tail -n 1 | tr -d ' ')
        local mem=$(ps -p "$pid" -o %mem | tail -n 1 | tr -d ' ')
        local etime=$(ps -p "$pid" -o etime | tail -n 1 | tr -d ' ')
        echo "=========================================="
        echo " 🟢 ESTADO: ULTRÓN ESTÁ ACTIVO Y ESCUCHANDO"
        echo "=========================================="
        echo " • PID del proceso : $pid"
        echo " • Tiempo activo   : $etime"
        echo " • Uso de CPU / RAM: ${cpu}% CPU / ${mem}% RAM"
        echo " • Sensibilidad    : Nivel $sens (Umbral de amplitud: $amp)"
        echo " • Palabra clave   : 'Hey Ultrón' / 'Ultrón'"
        echo " • Atajo teclado   : Option + Shift + E (Conmutador ON/OFF split-aware)"
        echo " • Modo ejecución  : En segundo plano"
        echo "------------------------------------------"
        echo "Para desactivarlo  : ultron off"
        echo "Para ver registros : ultron logs"
    else
        echo "=========================================="
        echo " ⚪ ESTADO: ULTRÓN ESTÁ DESACTIVADO"
        echo "=========================================="
        echo " No hay ningún proceso de escucha activo ni consumo de recursos."
        echo " • Sensibilidad config: Nivel $sens (Umbral: $amp)"
        echo "------------------------------------------"
        echo "Para activarlo: ultron on"
    fi
}

show_logs() {
    if [ -f "$LOG_FILE" ]; then
        echo "--- Últimas líneas de registro de Ultrón ---"
        tail -n 25 "$LOG_FILE"
    else
        echo "No hay archivo de registro disponible aún."
    fi
}

toggle_voice_call() {
    "$PYTHON_BIN" -c "
import urllib.request, json, asyncio, websockets, os

port_file = os.path.expanduser('~/Library/Application Support/Antigravity/DevToolsActivePort')
if not os.path.exists(port_file):
    print('❌ Antigravity no está abierto.')
    exit(1)

with open(port_file) as f: port = int(f.read().splitlines()[0])

try:
    req = urllib.request.Request(f'http://127.0.0.1:{port}/json')
    with urllib.request.urlopen(req, timeout=1.5) as resp: targets = json.loads(resp.read().decode())
    page = next((t for t in targets if t.get('type') == 'page' and not t.get('url', '').startswith('data:')), None)
    if not page:
        print('❌ No se encontró la ventana activa de Antigravity.')
        exit(1)

    async def toggle():
        async with websockets.connect(page['webSocketDebuggerUrl'], open_timeout=2) as ws:
            expr = '''
            (() => {
                function getTargetChatScope() {
                    const panes = Array.from(document.querySelectorAll('[data-pane-id]')).filter(p => 
                        p.querySelector('[data-testid=\"voice-start-button\"]') || 
                        p.querySelector('[data-testid=\"voice-call-end\"]') ||
                        p.querySelector('[data-testid=\"voice-call-controls\"]')
                    );
                    if (!panes.length) return document;
                    const focusedPane = panes.find(p => p.contains(document.activeElement));
                    if (focusedPane) return focusedPane;
                    const activePane = panes.find(p => !p.hasAttribute('data-pane-unfocused') && !p.closest('[data-pane-unfocused]'));
                    if (activePane) return activePane;
                    return panes[0] || document;
                }

                const scope = getTargetChatScope();
                const paneId = (scope.getAttribute && scope.getAttribute('data-pane-id')) || 'default';

                const endBtn = scope.querySelector('[data-testid=\"voice-call-end\"]') ||
                               scope.querySelector('[data-testid=\"voice-end-button\"]') ||
                               document.querySelector('[data-testid=\"voice-call-end\"]') ||
                               document.querySelector('[data-testid=\"voice-end-button\"]');
                if (endBtn) {
                    endBtn.click();
                    return { action: 'ended', pane: paneId };
                }
                const startBtn = scope.querySelector('[data-testid=\"voice-start-button\"]') ||
                                 document.querySelector('[data-testid=\"voice-start-button\"]');
                if (startBtn) {
                    startBtn.click();
                    return { action: 'started', pane: paneId };
                }
                return { action: 'none', pane: paneId };
            })()
            '''
            await ws.send(json.dumps({'id': 1, 'method': 'Runtime.evaluate', 'params': {'expression': expr, 'returnByValue': True}}))
            res = await ws.recv()
            val = json.loads(res).get('result', {}).get('result', {}).get('value', {})
            act = val.get('action')
            pane = val.get('pane', 'default')
            if act == 'ended':
                print(f'🛑 Llamada de voz finalizada (panel: {pane}).')
            elif act == 'started':
                print(f'🎙️ Llamada de voz iniciada en el panel activo ({pane}).')
            else:
                print('ℹ️ No se encontraron botones de control de voz.')

    asyncio.run(toggle())
except Exception as e:
    print('❌ Error:', e)
"
}

end_voice_call() {
    "$PYTHON_BIN" -c "
import urllib.request, json, asyncio, websockets, os

port_file = os.path.expanduser('~/Library/Application Support/Antigravity/DevToolsActivePort')
if not os.path.exists(port_file):
    print('❌ Antigravity no está abierto.')
    exit(1)

with open(port_file) as f: port = int(f.read().splitlines()[0])

try:
    req = urllib.request.Request(f'http://127.0.0.1:{port}/json')
    with urllib.request.urlopen(req, timeout=1.5) as resp: targets = json.loads(resp.read().decode())
    page = next((t for t in targets if t.get('type') == 'page' and not t.get('url', '').startswith('data:')), None)
    if not page:
        print('❌ No se encontró la ventana activa de Antigravity.')
        exit(1)

    async def end():
        async with websockets.connect(page['webSocketDebuggerUrl'], open_timeout=2) as ws:
            expr = '''
            (() => {
                const endBtn = document.querySelector('[data-testid=\"voice-call-end\"]') ||
                               document.querySelector('[data-testid=\"voice-end-button\"]');
                if (endBtn) {
                    endBtn.click();
                    return { ended: true };
                }
                return { ended: false };
            })()
            '''
            await ws.send(json.dumps({'id': 1, 'method': 'Runtime.evaluate', 'params': {'expression': expr, 'returnByValue': True}}))
            res = await ws.recv()
            val = json.loads(res).get('result', {}).get('result', {}).get('value', {})
            if val.get('ended'):
                print('🛑 Llamada de voz de Antigravity finalizada.')
            else:
                print('ℹ️ No hay ninguna llamada de voz activa para cerrar.')

    asyncio.run(end())
except Exception as e:
    print('❌ Error al finalizar llamada:', e)
"
}

set_sensitivity() {
    local lvl="$1"
    if [[ -z "$lvl" || ! "$lvl" =~ ^([1-9]|10)$ ]]; then
        echo "Uso: ultron sensitivity <1-10>"
        echo ""
        echo "Escala visual de sensibilidad:"
        echo "  10: Hipersensible (0.008) -> Capta susurros lejanos o audio bajo"
        echo "   8: Alta (0.025)"
        echo "   6: Equilibrada (0.050) [RECOMENDADA] -> Filtra videos de YouTube/Instagram"
        echo "   5: Moderada (0.065)"
        echo "   3: Firme (0.120)"
        echo "   1: Mínima (0.250) -> Solo voz muy alta y cercana"
        return 1
    fi
    "$PYTHON_BIN" -c "
import json, os
cfg_path = os.path.expanduser('~/.config/ultron-assistant/config.json')
SENSITIVITY_MAP = {
    10: 0.008, 9: 0.015, 8: 0.025, 7: 0.038, 6: 0.050,
    5: 0.065, 4: 0.085, 3: 0.120, 2: 0.180, 1: 0.250
}
lvl = int('$lvl')
amp = SENSITIVITY_MAP.get(lvl, 0.050)
cfg = {}
if os.path.exists(cfg_path):
    try:
        with open(cfg_path) as f: cfg = json.load(f)
    except Exception: pass
cfg['sensitivity_level'] = lvl
cfg['min_amplitude'] = amp
with open(cfg_path, 'w') as f: json.dump(cfg, f, indent=2)
print(f'✅ Sensibilidad ajustada al Nivel {lvl}/10 (umbral de amplitud: {amp:.3f}).')
"
    if is_running; then
        echo "Reiniciando Ultrón para aplicar cambios..."
        stop_ultron
        sleep 1
        start_ultron
    fi
}

run_test() {
    echo "🔍 Ejecutando autodiagnóstico de Ultrón..."
    if [ ! -f "$PYTHON_BIN" ]; then
        echo "❌ Entorno Python no encontrado en $PYTHON_BIN"
        return 1
    fi
    "$PYTHON_BIN" -c "
import os, sys, urllib.request, json
port_file = os.path.expanduser('~/Library/Application Support/Antigravity/DevToolsActivePort')
if not os.path.exists(port_file):
    print('⚠️ Antigravity no tiene el puerto CDP activo. ¿Está la app abierta?')
else:
    with open(port_file) as f: port = f.read().splitlines()[0]
    try:
        urllib.request.urlopen(f'http://127.0.0.1:{port}/json', timeout=1.5)
        print('✅ Conexión con Antigravity (CDP): Exitosa (puerto ' + str(port) + ')')
    except Exception as e:
        print('❌ Error contactando CDP de Antigravity:', e)
"
}

case "$1" in
    on|start|activar|iniciar)
        start_ultron
        ;;
    off|stop|desactivar|apagar)
        stop_ultron
        ;;
    toggle|alternar)
        toggle_voice_call
        ;;
    end|stop-call|hangup|colgar|cerrar)
        end_voice_call
        ;;
    sensitivity|sens|nivel)
        set_sensitivity "$2"
        ;;
    status|estado|check)
        show_status
        ;;
    logs|log)
        show_logs
        ;;
    test|diagnostico|diag)
        run_test
        ;;
    restart|reiniciar)
        stop_ultron
        sleep 1
        start_ultron
        ;;
    *)
        if is_running; then
            show_status
        else
            echo "Uso: ultron {on|off|toggle|end|sensitivity <1-10>|status|logs|test|restart}"
            echo ""
            echo "  ultron on               -> Activa a Ultrón en segundo plano"
            echo "  ultron off              -> Desactiva y detiene a Ultrón por completo"
            echo "  ultron toggle           -> Inicia o finaliza la voz (mismo que Option+Shift+E)"
            echo "  ultron end              -> Finaliza la llamada de voz activa"
            echo "  ultron sensitivity <1-10> -> Ajusta la sensibilidad de audio"
            echo "  ultron status           -> Muestra estado, consumo y nivel de sensibilidad"
            echo "  ultron logs             -> Muestra los registros recientes"
            echo "  ultron test             -> Ejecuta el autodiagnóstico de conexión"
        fi
        ;;
esac
